  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node scripts/database/check.mjs",
    "db:replay": "node scripts/database/replay.mjs",
    "core:check": "node --test scripts/database/core.test.mjs && node scripts/database/replay.mjs",
    "contracts:check": "node --test scripts/database/contracts.test.mjs scripts/database/auth-security.test.mjs && node scripts/database/replay.mjs",
    "contracts:test": "node --test scripts/database/contracts.test.mjs",
    "documents:check": "node --test scripts/database/documents-engine.test.mjs scripts/database/auth-security.test.mjs && node scripts/database/replay.mjs",
    "operations:check": "node --test scripts/database/auth-security.test.mjs && node scripts/database/replay.mjs",
    "economics:precheck": "node --test scripts/database/auth-security.test.mjs scripts/database/finance-decimal.test.mjs scripts/database/economics-isolation.test.mjs && node scripts/database/replay.mjs",
    "profitability:check": "node --test scripts/database/auth-security.test.mjs scripts/database/profitability.test.mjs scripts/database/economics-isolation.test.mjs && node scripts/database/replay.mjs",
    "db:test": "node --test scripts/database/compare.test.mjs",
