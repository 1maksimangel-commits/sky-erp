    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
